{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": [
              "apply",
              "config",
              "layer",
              "screen",
              "tailwind",
              "theme",
              "variants"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["metro.config.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noGlobalDirnameFilename": "off"
          }
        }
      }
    }
  ]
}
